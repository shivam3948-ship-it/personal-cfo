# Copy to .env.local and fill in. Never commit .env.local.
# --- AI (optional: without it a rule-based agent answers) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# --- Voice (optional: without it the browser speaks and listens) ---
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=
# --- Sign-in + database (optional: without it the app runs on the sample family only) ---
# Public values, safe in the browser bundle (Supabase → Project Settings → API):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret, server only. Used ONLY to remove a user's sign-in account on "delete all my data". Optional.
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 to offer "Use email instead" on the sign-in screen (fallback if SMS OTP is not working).
NEXT_PUBLIC_EMAIL_LOGIN=
# --- Demo ---
# DEMO_AS_OF=2026-10-15
