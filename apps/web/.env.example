# Copy to .env.local and fill in. Never commit .env.local.
# Reasoning (optional: without it the app runs the offline rule-based agent)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EXTRACT_MODEL=claude-sonnet-5-5

# Voice (optional: without it the browser's Web Speech API is used)
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_MODE=            # only for saaras:v3, e.g. codemix
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=         # must match the TTS model; leave empty for the API default
# SARVAM_TTS_PACE=1.05

# Pin "today" for demos (defaults to the latest date in the data)
# DEMO_AS_OF=2026-10-15
