{
  "name": "voice-cfo",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first personal CFO: Hindi/English voice agent over bank, card, SMS, email, loan, insurance and credit-report data.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:data": "node scripts/generate-demo-data.mjs",
    "demo:pdfs": "node scripts/make-pdfs.mjs",
    "eval:live": "RUN_LIVE=1 vitest run tests/eval.live.test.ts",
    "smoke": "node scripts/smoke-keys.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "build:web-demo": "node web-demo/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "esbuild": "^0.25.10",
    "pdf-lib": "1.17.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
